# syntax=docker/dockerfile:1
# Dev-only image: hot-reload via `next dev`, source is bind-mounted by
# docker-compose.yml at the repo root. No production Dockerfile exists yet
# for this app.
FROM node:24-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

# --hostname 0.0.0.0 is required so Next.js binds to all interfaces inside
# the container, not just 127.0.0.1 (which Docker cannot reach from the host).
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
