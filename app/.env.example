# The backend API base URL (health check will call ${EXPO_PUBLIC_API_BASE_URL}/v1/health)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Public Firebase web-app configuration used only for federated authentication.
# Provision separate non-production and production Firebase projects.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=stitchwish-d3b28
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Google OAuth clients. The web client ID is the Firebase Auth audience; the
# iOS client ID also lets app.config.ts derive the reversed callback scheme.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional override if the derived reversed client ID is not appropriate.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Sentry (ADR-0035). The DSN is a public client key, not a secret - it's the
# avk-corp/stitch-wish project DSN, safe to commit. SENTRY_AUTH_TOKEN (source
# map upload during EAS builds) is a real secret and must only live in EAS
# environment variables, never here.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
