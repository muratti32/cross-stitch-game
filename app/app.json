{
  "expo": {
    "name": "Stitch Wish",
    "slug": "stitch-wish",
    "version": "1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stitchwish",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avk.stitchwish",
      "appleTeamId": "X25YH9627H",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:stitchwish.avkdesign.net"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.avk.stitchwish",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "stitchwish.avkdesign.net",
              "pathPrefix": "/pattern"
            },
            {
              "scheme": "https",
              "host": "stitchwish.avkdesign.net",
              "pathPrefix": "/profile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/transparent-heart.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stitch Wish uses selected photos to frame Personal Patterns or upload a public creator profile photo you choose."
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "organization": "avk-corp",
          "project": "stitch-wish",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "uploadNativeSymbols": true,
            "autoUploadNativeSymbols": true,
            "includeProguardMapping": true,
            "autoUploadProguardMapping": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "buildArchs": [
              "arm64-v8a"
            ]
          },
          "ios": {
            "extraPods": [
              {
                "name": "AppCheckCore",
                "modular_headers": true
              },
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "locales": {
      "en": "./src/i18n/locales/en/native.json",
      "tr": "./src/i18n/locales/tr/native.json",
      "fr": "./src/i18n/locales/fr/native.json",
      "es": "./src/i18n/locales/es/native.json",
      "pt-BR": "./src/i18n/locales/pt-BR/native.json",
      "de": "./src/i18n/locales/de/native.json",
      "it": "./src/i18n/locales/it/native.json",
      "ar": "./src/i18n/locales/ar/native.json",
      "ja": "./src/i18n/locales/ja/native.json",
      "ko": "./src/i18n/locales/ko/native.json",
      "nl": "./src/i18n/locales/nl/native.json",
      "pl": "./src/i18n/locales/pl/native.json",
      "ru": "./src/i18n/locales/ru/native.json",
      "zh-Hans": "./src/i18n/locales/zh-Hans/native.json",
      "zh-Hant": "./src/i18n/locales/zh-Hant/native.json",
      "ca": "./src/i18n/locales/ca/native.json",
      "cs": "./src/i18n/locales/cs/native.json",
      "da": "./src/i18n/locales/da/native.json",
      "el": "./src/i18n/locales/el/native.json",
      "fi": "./src/i18n/locales/fi/native.json",
      "hi": "./src/i18n/locales/hi/native.json",
      "hr": "./src/i18n/locales/hr/native.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e84c5981-5ec9-4f27-892b-e801f6efb845"
      }
    },
    "owner": "muratti32"
  }
}
