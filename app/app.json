{
  "expo": {
    "name": "Stitch Wish",
    "slug": "stitch-wish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stitchwish",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avk.stitchwish"
    },
    "android": {
      "package": "com.avk.stitchwish",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e84c5981-5ec9-4f27-892b-e801f6efb845"
      }
    },
    "owner": "muratti32"
  }
}
