{
  "expo": {
    "name": "Stitch Wish",
    "slug": "stitch-wish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stitchwish",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avk.stitchwish",
      "appleTeamId": "X25YH9627H",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.avk.stitchwish",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stitch Wish uses your selected photo only on this device to frame a Personal Pattern before conversion."
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "organization": "avk-corp",
          "project": "stitch-wish"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "AppCheckCore",
                "modular_headers": true
              },
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e84c5981-5ec9-4f27-892b-e801f6efb845"
      }
    },
    "owner": "muratti32"
  }
}
