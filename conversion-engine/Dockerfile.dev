# syntax=docker/dockerfile:1
# Dev-only image: hot-reload via `uvicorn --reload`, source is bind-mounted
# by docker-compose.yml at the repo root. Not used for production builds —
# see Dockerfile for the production build.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8000

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e .

EXPOSE 8000

CMD ["uvicorn", "stitch_wish.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/src"]
