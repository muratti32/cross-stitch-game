# Base URL of the backend NestJS API (backend/src/main.api.ts), no trailing
# path — this client appends /v1/admin itself.
ADMIN_API_URL=http://localhost:3000

# Operator account credentials (backend operator_accounts table).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: the base32 TOTP secret from this operator's authenticator
# enrollment (the same secret encoded in the otpauth:// QR code shown at
# signup). If set, admin_login generates the current 6-digit code itself and
# completes MFA in one call — no manual admin_verify_mfa step needed.
#
# The backend still enforces MFA on every login (ADR-0039); this does not
# disable it server-side. But storing the TOTP secret next to the password
# in the same file does collapse two-factor auth into one factor for anyone
# who can read this file. Leave this unset to keep entering the live code
# by hand via admin_verify_mfa instead.
ADMIN_TOTP_SECRET=
