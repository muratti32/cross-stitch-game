{
  "clearMocks": true,
  "collectCoverageFrom": [
    "<rootDir>/src/**/*.ts",
    "!<rootDir>/src/main.*.ts",
    "!<rootDir>/src/**/*.module.ts",
    "!<rootDir>/src/database/migrations/**/*.ts"
  ],
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/src/**/*.spec.ts",
    "<rootDir>/test/**/*.spec.ts"
  ],
  "testPathIgnorePatterns": ["\\.integration-spec\\.ts$"],
  "watchman": false,
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  }
}
