# Local development values only. Use managed secrets in deployed environments.
DATABASE_URL=postgresql://stitch_wish:stitch_wish_dev@localhost:5432/stitch_wish
REDIS_URL=redis://localhost:6379
CONVERSION_ENGINE_URL=http://127.0.0.1:8000
CONVERSION_WORKER_CONCURRENCY=2
PORT=3000
JWT_SECRET=dev-only-not-a-real-secret-replace-before-deploy
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
STORAGE_LOCAL_DIR=./storage-dev
GRANT_TTL_SECONDS=300
GRANT_SIGNING_SECRET=dev-only-not-a-real-signing-secret-replace-before-deploy
OTP_SIGNING_SECRET=dev-only-not-a-real-otp-signing-secret-replace-before-deploy
EMAIL_FROM_ADDRESS=dev@example.test
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RATE_LIMIT_PER_EMAIL=5
EMAIL_OTP_RATE_LIMIT_PER_IP=20
# Omit RESEND_API_KEY to use the in-memory LocalEmailSender during development.
# RESEND_API_KEY=dev-only-not-a-real-resend-api-key-replace-before-deploy
