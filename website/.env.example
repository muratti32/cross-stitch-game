# Public Game Backend API base URL (no trailing slash).
# Required for the Account Deletion form to submit deletion requests.
# Leave blank during development to see the "API not configured" banner.
VITE_API_URL=

# URL of the Operator Console (admin-console Next.js app).
# Shown as a small link in the footer.
VITE_ADMIN_CONSOLE_URL=http://localhost:3001
